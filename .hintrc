{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/forms": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-text-size-adjust",
          "text-decoration-skip-ink",
          "text-align: -webkit-match-parent",
          "overflow-anchor",
          "-webkit-mask"
        ]
      }
    ],
    "no-inline-styles": "off"
  }
}